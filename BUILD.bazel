load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

COPTS = select({
    "@platforms//os:windows": ["/W4"],
    "//conditions:default": [
        "-Wall",
        "-Wextra",
    ],
})

# The tool: bazel build -c opt //:strip-credentials
cc_binary(
    name = "strip-credentials",
    srcs = ["strip_credentials.cpp"],
    copts = COPTS,
    visibility = ["//visibility:public"],
)

# The tests #include the tool's .cpp directly so they can reach its internals (analyze, process,
# run, ...). Exposing it as a textual header puts it in the test's sandbox without compiling it a
# second time as its own translation unit (which would define main() twice).
cc_library(
    name = "strip_credentials_source",
    textual_hdrs = ["strip_credentials.cpp"],
)

# Unit + property tests. Run a subset with: --test_arg=<substring of a test name>
cc_test(
    name = "strip_credentials_test",
    size = "small",
    srcs = ["test_strip_credentials.cpp"],
    copts = COPTS,
    deps = [":strip_credentials_source"],
)
